<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    <meta charset="utf-8">
    <title>Page moved</title>
    <link rel="canonical" href="{{ page.redirect_to | absolute_url }}">
    <meta http-equiv="refresh" content="0; url={{ page.redirect_to | relative_url }}">
  </head>
  <body>
    <p>This page has moved. <a href="{{ page.redirect_to | relative_url }}">Continue to the updated page.</a></p>
    <script>
      const target = new URL({{ page.redirect_to | relative_url | jsonify }}, window.location.href);
      if (window.location.search) target.search = window.location.search;
      if (!target.hash) target.hash = window.location.hash;
      window.location.replace(target.href);
    </script>
  </body>
</html>
