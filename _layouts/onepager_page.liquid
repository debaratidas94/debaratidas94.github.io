---
layout: onepager_base
---

<link rel="stylesheet" href="{{ '/assets/css/onepager.css' | relative_url }}">

<div class="op-wrap">
  <div class="op-page">
    {% include onepager_tabs.liquid %}

    {% if page.kicker %}
      <p class="op-kicker">{{ page.kicker }}</p>
    {% endif %}

    <h1 class="op-page-title">{{ page.title }}</h1>

    {% if page.section == 'mentorship' %}
      <section class="op-section op-section--first op-timeline" id="mentorship" aria-labelledby="mentorship-title">
        <h2 class="op-section-title" id="mentorship-title">Mentorship</h2>
        <p class="op-timeline-intro">Grouped by mentorship start year. Affiliations reflect current positions.</p>
        {% assign mentorship_years = site.data.mentorship | group_by: 'year' | sort: 'name' | reverse %}
        {% for group in mentorship_years %}
          <div class="op-year-row">
            <h3 class="op-year">{{ group.name }}</h3>
            <div class="op-year-items">
              {% for m in group.items %}
                <article class="op-entry">
                  <p class="op-mentee-line">
                    <strong class="op-mentee-name">{% if m.url %}<a href="{{ m.url | escape }}" target="_blank" rel="noopener">{{ m.name | escape }}</a>{% else %}{{ m.name | escape }}{% endif %}</strong>,
                    <span class="op-mentee-affiliation">{{ m.designation | escape }}</span>
                  </p>
                  {% if m.papers %}
                    <ul class="op-mentee-papers">
                      {% for key in m.papers %}
                        {% assign paper = site.data.publication_explorer.papers | where: 'key', key | first %}
                        {% assign paper_url = paper.url %}
                        {% if paper_url == '' %}
                          {% capture paper_path %}/publications/#paper-{{ key }}{% endcapture %}
                          {% assign paper_url = paper_path | relative_url %}
                        {% endif %}
                        <li><a href="{{ paper_url | escape }}" data-paper="{{ key | escape }}">{{ paper.title | escape }}</a></li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </section>

    {% elsif page.section == 'awards' %}
      <section class="op-section op-section--first op-timeline" id="patents" aria-labelledby="patents-title">
        <h2 class="op-section-title" id="patents-title">Patents</h2>
        {% assign patent_years = site.data.patents | group_by: 'year' | sort: 'name' | reverse %}
        {% for group in patent_years %}
          <div class="op-year-row">
            <h3 class="op-year">{{ group.name }}</h3>
            <div class="op-year-items">
              {% for patent in group.items %}
                <article class="op-entry">
                  <h4 class="op-entry-title">{{ patent.title | escape }}</h4>
                  <p class="op-entry-meta">{{ patent.status | escape }}</p>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </section>

      <section class="op-section op-timeline" id="awards" aria-labelledby="awards-title">
        <h2 class="op-section-title" id="awards-title">Awards</h2>
        {% assign grouped = site.data.awards | group_by: 'year' | sort: 'name' | reverse %}
        {% for group in grouped %}
          <div class="op-year-row">
            <h3 class="op-year">{{ group.name }}</h3>
            <div class="op-year-items">
              {% for award in group.items %}
                <article class="op-entry">
                  <details class="op-award-details">
                    <summary class="op-entry-title">{{ award.name }}</summary>
                    {% if award.paper_title and award.paper_url %}
                      <p class="op-entry-note"><a href="{{ award.paper_url | escape }}" target="_blank" rel="noopener">{{ award.paper_title | escape }}</a></p>
                    {% endif %}
                    {% if award.about and award.about != '' %}
                      <p class="op-entry-note">{{ award.about }}</p>
                    {% endif %}
                    {% if award.url and award.url != '#' %}
                      <p class="op-entry-meta"><a href="{{ award.url | escape }}" target="_blank" rel="noopener">Official award listing</a></p>
                    {% endif %}
                  </details>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </section>

    {% elsif page.section == 'talks' %}
      <section class="op-section op-section--first">
        {% for talk in site.data.talks %}
          <div class="op-year-row">
            <div class="op-year">{{ talk.date }}</div>
            <div class="op-year-items">
              <article class="op-entry">
                <h3 class="op-entry-title">
                  {% if talk.url and talk.url != '' %}
                    <a href="{{ talk.url }}" target="_blank" rel="noopener">{{ talk.title }}</a>
                  {% else %}
                    {{ talk.title }}
                  {% endif %}
                </h3>
                <p class="op-entry-meta">{{ talk.venue }}</p>
                {% if talk.about and talk.about != '' %}
                  <p class="op-entry-note">{{ talk.about }}</p>
                {% endif %}
                {% if talk.slides and talk.slides != '' %}
                  <div class="op-news-tags">
                    <a
                      class="op-link-tag"
                      data-link-tag="slides"
                      href="{{ talk.slides }}"
                      target="_blank"
                      rel="noopener"
                    >slides</a>
                  </div>
                {% endif %}
              </article>
            </div>
          </div>
        {% endfor %}
      </section>

    {% elsif page.section == 'service' %}
      {% assign service_groups = site.data.service | group_by: 'category' %}
      {% for group in service_groups %}
      {% assign section_id = group.name | slugify %}
      <section class="op-section{% if forloop.first %} op-section--first{% endif %}" id="{{ section_id }}" aria-labelledby="{{ section_id }}-title">
        <h2 class="op-section-title" id="{{ section_id }}-title">{{ group.name }}</h2>
        {% if group.items.first.summary %}
          <ul class="op-plain-list">
            {% for item in group.items %}
              <li><strong>{{ item.role | escape }}{% if item.period %} ({{ item.period | escape }}){% endif %}:</strong> {{ item.summary | escape }}</li>
            {% endfor %}
          </ul>
        {% else %}
        {% for item in group.items %}
          <div class="op-year-row">
            <div class="op-year">
              <div class="op-year-role">{{ item.role }}</div>
              <div class="op-year-period">{{ item.period }}</div>
            </div>
            <div class="op-year-items">
              {% if item.org and item.org != '' %}
                <h3 class="op-entry-title">{{ item.org }}</h3>
              {% endif %}
              {% if item.sections %}
                {% for section in item.sections %}
                  <p class="op-sublabel">{{ section.label }}</p>
                  <ul class="op-plain-list">
                    {% for entry in section.entries %}
                      <li>{{ entry }}</li>
                    {% endfor %}
                  </ul>
                {% endfor %}
              {% endif %}
              {% if item.bullets %}
                <ul class="op-plain-list">
                  {% for bullet in item.bullets %}
                    <li>{{ bullet }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        {% endif %}
      </section>
      {% endfor %}

      <section class="op-section" id="teaching" aria-labelledby="teaching-title">
        <h2 class="op-section-title" id="teaching-title">Teaching</h2>
        <p class="op-entry-title">University of Minnesota Twin Cities</p>
        <ul class="op-plain-list">
          {% for course in site.data.teaching %}
            <li><strong>{{ course.period | escape }}</strong> {{ course.role | escape }}, {% if course.url %}<a href="{{ course.url | escape }}">{{ course.title | escape }}</a>{% else %}{{ course.title | escape }}{% endif %} ({{ course.summary | escape }})</li>
          {% endfor %}
        </ul>
      </section>

    {% elsif page.section == 'news' %}
      <section class="op-section op-section--first op-updates">
        {% assign news_types = site.data.news | map: 'type' | uniq %}
        <div class="op-news-filters" id="opNewsFilters">
          <button class="op-news-filter is-active" type="button" data-type="all">All</button>
          {% for t in news_types %}
            <button class="op-news-filter" type="button" data-type="{{ t }}">{{ t | downcase | capitalize }}</button>
          {% endfor %}
        </div>
        <ol class="op-news-list op-news-list--full" id="opNews">
          {% for item in site.data.news %}
            <li class="op-news-item" data-type="{{ item.type }}">
              <div class="op-news-meta">
                {% if item.type %}<span class="op-news-type">{{ item.type | downcase | capitalize }}</span>{% endif %}
                <span class="op-news-date">{{ item.date }}</span>
              </div>
              <div class="op-news-text">
                {{ item.text | markdownify | remove: '<p>' | remove: '</p>' | strip }}
              </div>
              {% if item.tags %}
                <div class="op-news-tags">
                  {% for tag in item.tags %}
                    {% if tag.url %}
                      <a
                        class="op-link-tag"
                        data-link-tag="{{ tag.label | downcase }}"
                        href="{{ tag.url }}"
                        target="_blank"
                        rel="noopener"
                      >{{ tag.label | downcase }}</a>
                    {% else %}
                      <span class="op-link-tag" data-link-tag="{{ tag | downcase }}">{{ tag | downcase }}</span>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      </section>

    {% elsif page.section == 'publications' %}
      <section class="op-section op-section--first">
        {% include publication_explorer.liquid %}
      </section>
    {% endif %}

    <div class="op-intro op-page-body">{{ content }}</div>
  </div>
</div>

{% include onepager_scripts.liquid %}
