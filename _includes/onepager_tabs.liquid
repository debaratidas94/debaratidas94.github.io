{% comment %}
  Shared tab row for the one-pager site. Driven by _data/onepager_nav.yml so
  both layouts stay in sync. A page is active when its url matches, so the
  tabs keep you inside the new site instead of dropping into the old pages.
{% endcomment %}
<nav class="op-tabs">
  {% for tab in site.data.onepager_nav %}
    <a
      class="op-tab{% if page.url == tab.url %} is-active{% endif %}"
      href="{{ tab.url | relative_url }}"
    >{{ tab.label }}</a>
  {% endfor %}
  {% if site.enable_darkmode %}
    <button class="op-tab" id="light-toggle" type="button" aria-label="Change theme (system, light, dark)" title="Cycle system, light, and dark mode">
      Light / dark
    </button>
  {% endif %}
</nav>
